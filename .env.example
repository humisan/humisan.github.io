# Spotify API Configuration
# Get these credentials from https://developer.spotify.com/dashboard
# 1. Create a Spotify app at the Developer Dashboard
# 2. Copy your Client ID and Client Secret
# 3. Set these environment variables during build time

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# GitHub API Configuration (Optional)
# Increase rate limits from 60 to 5000 requests/hour
# Get a personal access token from https://github.com/settings/tokens
# Permissions needed: public_repo (read-only)

GITHUB_TOKEN=your_github_personal_access_token_here
